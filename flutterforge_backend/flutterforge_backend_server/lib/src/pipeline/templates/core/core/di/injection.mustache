import 'package:get_it/get_it.dart';

{{#hasNetwork}}
import 'package:dio/dio.dart';
import 'network/api_client.dart';
{{/hasNetwork}}
{{#hasLocalStorage}}
import 'storage/local_storage.dart';
{{/hasLocalStorage}}

{{#hasAuth}}
import '../../features/auth/data/datasources/auth_remote_datasource.dart';
import '../../features/auth/data/repositories/auth_repository_impl.dart';
import '../../features/auth/domain/repositories/auth_repository.dart';
import '../../features/auth/domain/usecases/sign_in_usecase.dart';
import '../../features/auth/domain/usecases/sign_out_usecase.dart';
import '../../features/auth/presentation/cubit/auth_cubit.dart';
{{/hasAuth}}

{{#features}}
import '../../features/{{slug}}/data/datasources/{{slug}}_remote_datasource.dart';
import '../../features/{{slug}}/data/repositories/{{slug}}_repository_impl.dart';
import '../../features/{{slug}}/domain/repositories/{{slug}}_repository.dart';
import '../../features/{{slug}}/domain/usecases/{{slug}}_usecase.dart';
import '../../features/{{slug}}/presentation/bloc/{{slug}}_bloc.dart';
{{/features}}

final sl = GetIt.instance;

Future<void> init() async {
  // Core
  {{#hasNetwork}}
  sl.registerLazySingleton(() => Dio());
  sl.registerLazySingleton(() => ApiClient(sl()));
  {{/hasNetwork}}
  {{#hasLocalStorage}}
  sl.registerLazySingleton<LocalStorage>(() => LocalStorageImpl());
  {{/hasLocalStorage}}

  // Modules
  {{#hasAuth}}
  // Auth
  sl.registerFactory(() => AuthCubit(sl(), sl()));
  sl.registerLazySingleton(() => SignInUseCase(sl()));
  sl.registerLazySingleton(() => SignOutUseCase(sl()));
  sl.registerLazySingleton<AuthRepository>(() => AuthRepositoryImpl(sl()));
  sl.registerLazySingleton<AuthRemoteDataSource>(() => AuthRemoteDataSourceImpl());
  {{/hasAuth}}

  {{#features}}
  // {{className}}
  sl.registerFactory(() => {{className}}Bloc(sl()));
  sl.registerLazySingleton(() => {{className}}UseCase(sl()));
  sl.registerLazySingleton<{{className}}Repository>(() => {{className}}RepositoryImpl(sl()));
  sl.registerLazySingleton<{{className}}RemoteDataSource>(() => {{className}}RemoteDataSourceImpl(sl()));
  {{/features}}
}

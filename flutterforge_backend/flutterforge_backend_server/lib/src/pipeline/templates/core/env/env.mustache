enum AppEnvironment { dev, staging, prod }

abstract class EnvConfig {
  String get name;
  String get apiBaseUrl;
}

class DevEnv implements EnvConfig {
  @override
  String get name => 'development';
  @override
  String get apiBaseUrl => '{{apiBaseUrl}}/dev';
}

class ProdEnv implements EnvConfig {
  @override
  String get name => 'production';
  @override
  String get apiBaseUrl => '{{apiBaseUrl}}/v1';
}

class AppEnv {
  static late EnvConfig config;
  
  static void init(AppEnvironment environment) {
    switch (environment) {
      case AppEnvironment.prod:
        config = ProdEnv();
        break;
      case AppEnvironment.dev:
      default:
        config = DevEnv();
        break;
    }
  }
}
